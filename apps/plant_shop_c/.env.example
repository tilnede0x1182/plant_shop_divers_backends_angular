DATABASE_PASS=            				# mot de passe SQL

# ───────────────
#  HTTP serveur
# ───────────────
SERVER_ADDRESS=4100               # port exposé par Kore

# ───────────────
#  JWT / Sécurité
# ───────────────
JWT_SECRET=
