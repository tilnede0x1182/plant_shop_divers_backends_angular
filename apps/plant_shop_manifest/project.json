{
  "name": "plant_shop_manifest",
  "projectType": "application",
  "sourceRoot": "apps/plant_shop_manifest",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node node_modules/manifest/scripts/watch/watch.js apps/plant_shop_manifest/manifest.yaml"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node node_modules/manifest/scripts/start/start.js apps/plant_shop_manifest/manifest.yaml"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node node_modules/manifest/scripts/build/build.js apps/plant_shop_manifest/manifest.yaml"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node node_modules/manifest/dist/manifest/src/seed/scripts/seed.js apps/plant_shop_manifest/manifest.yaml"
      }
    }
  },
  "tags": []
}
