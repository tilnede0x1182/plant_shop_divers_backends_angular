{
  "name": "plantshopmanifest",
  "version": "0.1.0",
  "description": "A backend made with Manifest: https://manifest.build",
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "manifest": "^4.17.8",
    "node-fetch": "^3.3.2"
  },
  "scripts": {
    "dev": "npx dotenv -e .env -- node ../../node_modules/manifest/scripts/watch/watch.js manifest.yml",
    "build": "node ../../node_modules/manifest/scripts/build/build.js manifest.yml",
    "start": "node ../../node_modules/manifest/scripts/start/start.js manifest.yml",
    "seed": "node ../../node_modules/manifest/dist/manifest/src/seed/scripts/seed.js manifest.yml"
  }
}
