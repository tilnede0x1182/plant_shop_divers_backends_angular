  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "manifest": "^4.17.13",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3"
  },
  "scripts": {
    "dev": "npx dotenv -e .env -- node node_modules/manifest/scripts/watch/watch.js manifest.yml",
