# ─────────────────────────────────────────────────────────────────────────────
# 🌳 Monorepo Plant Shop – .gitignore global (frontend + Go + Rust)
# ─────────────────────────────────────────────────────────────────────────────

# ─── 📦 Sorties compilées (Angular / Vite / autres) ─────────────────────────
dist
tmp
out-tsc
.angular
vite.config.*.timestamp*
vitest.config.*.timestamp*

# ─── 📦 Dépendances Node / Yarn / pnpm ──────────────────────────────────────
*node_modules/
node_modules/
apps/plant_shop_manifest_ABANDON/node_modules/

# ─── 🧑‍💻 Fichiers projet des IDE / éditeurs ────────────────────────────────
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# ─── 💻 VS Code – garder seulement la config utile ──────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ─── 🧹 Caches, logs & divers JS/TS ─────────────────────────────────────────
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# ─── 🖥️ Fichiers système ───────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── 🛠️ Nx / outils monorepo ───────────────────────────────────────────────
.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# ─── 🔑 Environnements & secrets (toutes stacks) ────────────────────────────
.env            # fichier principal
.env.*          # variantes (.env.local, .env.dev, …)

# ─── 📝 Prisma (backend Node) ───────────────────────────────────────────────
prisma/*.tsbuildinfo
users.txt

# ─── 📄 Fichier agrégat de projet (dump) ────────────────────────────────────
projet.txt

# ─────────────────────────────────────────────────────────────────────────────
# 🐹 Backend Go – fichiers spécifiques
# ─────────────────────────────────────────────────────────────────────────────
/bin/           # binaire compilé (go build -o bin/server …)
/vendor/        # dépendances locales si 'go mod vendor'
*.out           # couverture de test Go
*.test          # artefacts de build/tests Go

# ─────────────────────────────────────────────────────────────────────────────
# 🦀 Backend Rust – fichiers spécifiques
# ─────────────────────────────────────────────────────────────────────────────
/bin/           # binaire compilé (out-dir bin)
/target/        # dossier de compilation Rust
*/bin/          # binaire compilé (out-dir bin)
*/target/       # dossier de compilation Rust
apps/plant_shop_rust/bin/         # binaire compilé (out-dir bin)
apps/plant_shop_rust/target/      # dossier de compilation Rust
*.exe          # binaire Windows
*.dll          # librairie dynamique Windows
*.so           # librairie dynamique Linux
*.dylib        # librairie dynamique macOS

Cargo.lock      # lockfile Rust (optionnel pour lib, conseillé pour bin)

# 🗄️ SQLx / migrations
sqlx-data.json  # cache d'introspection SQLx

# 🗒️ Logs & fichiers temporaires
*.log
*.swp
*.swo

# 🧑‍💻 Fichiers IDE (rappel)
.idea/
.vscode/
